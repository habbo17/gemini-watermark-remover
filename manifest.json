{
  "manifest_version": 3,
  "name": "domara",
  "version": "3.0.0",
  "description": "Remove Gemini watermarks locally - instant, pixel-perfect, 100% private",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open domara",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs"
  ],
  "offline_enabled": true
}
